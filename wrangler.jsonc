{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "haxball-replay-bot",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",

  "vars": {
    // Filled in by `npm run setup`: your Discord app's ID and public key, and the bot's own address.
    "DISCORD_APP_ID": "PASTE_APPLICATION_ID_HERE",
    "DISCORD_PUBLIC_KEY": "PASTE_PUBLIC_KEY_HERE",
    "PUBLIC_URL": "",

    // Optional auto mode: IDs of channels where the bot replies to every new .hbr2 file by itself,
    // separated by commas. Leave empty to turn it off. See README, step 7.
    "AUTO_CHANNEL_IDS": ""
  },

  // Copies of the .hbr2 files (Discord's own file links expire after about a day).
  // Created automatically on the first deploy.
  "kv_namespaces": [{ "binding": "REPLAYS" }],

  // Runs auto mode once a minute. It does nothing while AUTO_CHANNEL_IDS is empty.
  "triggers": { "crons": ["* * * * *"] },

  "observability": { "enabled": true }
}
